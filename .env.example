# --- Database ---
DATABASE_URL="postgresql://ghl_theme_builder:ghl_theme_builder@localhost:55432/ghl_theme_builder"

# --- GHL Marketplace app credentials ---
# Register the app at marketplace.gohighlevel.com -> My Apps -> Create App, named "Mosaic",
# Distribution/Installation Scope: "Agency & Sub-account". Then paste its values below.
GHL_APP_CLIENT_ID=
GHL_APP_CLIENT_SECRET=
# "Shared Secret Key" under Advanced Settings - used to decrypt SSO payloads (Phase 2)
GHL_APP_SHARED_SECRET=
GHL_SDK_LOG_LEVEL=warn

# --- Webhook signature verification (SDK reads these directly) ---
# Ed25519 (current/preferred) - public key GHL gives you for the app
WEBHOOK_SIGNATURE_PUBLIC_KEY=
# Legacy fallback - not needed post cutover (2026-07-01) but the SDK supports it
WEBHOOK_PUBLIC_KEY=

# --- Webhook audit retention (optional; defaults shown) ---
# WebhookEvent rows are both the idempotency key and the audit trail. Both windows are
# far longer than GHL's retry window, so pruning can never let a redelivery re-run a
# handler. Failed events are kept much longer - a handler that has been failing for a
# fortnight is the most useful row in the table.
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_FAILED_RETENTION_DAYS=180

# --- App server ---
PORT=3210
# Public HTTPS URL for this server (ngrok tunnel in dev) - used to build the theme-bundle
# snippet shown on the onboarding screen and as the OAuth Redirect/Webhook URL in the dev portal.
# Update this to whatever ngrok prints (check http://localhost:4040) each time the tunnel restarts,
# unless you're on a paid ngrok plan with a static domain.
APP_PUBLIC_URL=https://your-ngrok-subdomain.ngrok-free.app
# Origin of the apps/admin-dashboard dev server, allowed to call /admin/api/* via CORS
ADMIN_DASHBOARD_URL=http://localhost:5173

# --- ngrok (infra/docker-compose.yml ngrok service) ---
# Free account at ngrok.com -> dashboard -> "Your Authtoken"
NGROK_AUTHTOKEN=

# --- Local secrets ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Dashboard session auth (set true in production to require signed tokens on /admin/api)
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_TOKEN_SECRET=

# --- Support bot ---
# platform.openai.com -> API keys -> Create new secret key. Missing is NOT fatal: the bot
# degrades to "let me get someone from the team" and theming is completely unaffected.
OPENAI_API_KEY=
# Model ids and prices move faster than this code, so it's an env var. Measure leak rate
# with `npm run eval-models` before dropping tiers.
OPENAI_MODEL=gpt-5-mini

# --- Email (Resend) ---
# Optional. Unset = notifications are logged, not sent, and nothing else changes: an
# escalation still appears in the desk queue and a hand-off is still recorded. Email is
# a convenience here, never the mechanism.
# resend.com -> API keys. EMAIL_FROM needs SPF/DKIM on your domain before it will deliver.
RESEND_API_KEY=
EMAIL_FROM=Mosaic Support <support@yourdomain.com>
# Where "a client is waiting" alerts go. Comma-separated. Unset = no alert; the inbox
# still shows waiting time, which is why the queue is the source of truth.
DESK_NOTIFY_EMAIL=

# --- Support desk (apps/support-desk) ---
# Origin of the desk app, allowed to call /desk/api/* with credentials. Unset falls back
# to the localhost dev origin, so the failure mode is "the desk can't reach the API",
# never "the API accepts any origin".
SUPPORT_DESK_URL=http://localhost:5174

# --- Local-only test escape hatch ---
# Lets `safeFetch` reach 127.0.0.1 on any port, which `scratchpad/verify-feeds.ts` needs
# because it serves its fixture feed from an ephemeral loopback server rather than a stub.
# LEAVE THIS UNSET. It is loopback-only — never link-local, so the cloud metadata endpoint
# stays blocked either way — and it refuses itself whenever APP_PUBLIC_URL is a real https
# host, so setting it on the deployed service does nothing at all. Guarded by
# services/safeFetch.test.ts.
# SAFE_FETCH_ALLOW_LOOPBACK=

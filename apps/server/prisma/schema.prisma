generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationStatus {
  pending
  active
  removed
}

enum WebhookStatus {
  received
  processed
  failed
}

model AgencyInstall {
  id                String    @id @default(cuid())
  ghlCompanyId      String    @unique
  companyName       String?
  userId            String?
  userType          String?
  accessTokenEnc    String
  refreshTokenEnc   String
  tokenExpiresAt    DateTime
  scopes            String?
  status            String    @default("active")
  installedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  locations         LocationInstall[]
  menuLink          CustomMenuLinkRegistration?
  defaultTheme      AgencyDefaultTheme?
  presets           ThemePreset[]

  @@index([status])
}

model LocationInstall {
  id                String    @id @default(cuid())
  agencyInstallId   String
  agencyInstall     AgencyInstall @relation(fields: [agencyInstallId], references: [id])
  ghlLocationId     String    @unique
  locationName      String?
  status            LocationStatus @default(pending)
  enabled           Boolean   @default(false)
  userId            String?
  userType          String?
  accessTokenEnc    String?
  refreshTokenEnc   String?
  tokenExpiresAt    DateTime?
  scopes            String?
  installedAt       DateTime?
  activatedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  themeConfigs      ThemeConfig[]

  @@index([agencyInstallId])
  @@index([status])
}

model ThemeConfig {
  id                  String    @id @default(cuid())
  locationInstallId   String
  locationInstall     LocationInstall @relation(fields: [locationInstallId], references: [id])
  brandName           String?
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  // New visual fields (also present on AgencyDefaultTheme / ThemePreset)
  fontFamily          String?
  gradientEnabled     Boolean   @default(false)
  gradientColor       String?
  gradientAngle       Int       @default(135)
  topBarColor         String?
  // Advanced look/policy (also on AgencyDefaultTheme)
  buttonColor         String?
  cornerRadius        Int?
  sidebarImageUrl     String?
  scrollbarColor      String?
  darkMode            Boolean   @default(false)
  hideUpgrade         Boolean   @default(false)
  alertMessage        String?
  alertColor          String?
  menuLabelOverrides  Json?
  hiddenFeatures      Json?
  customCssOverride   String?
  version             Int       @default(1)
  updatedByUserId     String?
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())

  @@index([locationInstallId])
}

// One agency-wide default look. Applied to every sub-account UNLESS that
// sub-account has its own ThemeConfig, which overrides (enforced in CSS by
// specificity: agency default = unscoped sidebar selector, location = scoped).
model AgencyDefaultTheme {
  id                  String    @id @default(cuid())
  agencyInstallId     String    @unique
  agencyInstall       AgencyInstall @relation(fields: [agencyInstallId], references: [id])
  logoUrl             String?
  faviconUrl          String?
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  fontFamily          String?
  gradientEnabled     Boolean   @default(false)
  gradientColor       String?
  gradientAngle       Int       @default(135)
  topBarColor         String?
  buttonColor         String?
  cornerRadius        Int?
  sidebarImageUrl     String?
  scrollbarColor      String?
  darkMode            Boolean   @default(false)
  hideUpgrade         Boolean   @default(false)
  alertMessage        String?
  alertColor          String?
  customCss           String?
  menuLabelOverrides  Json?
  hiddenFeatures      Json?
  updatedAt           DateTime  @updatedAt
  createdAt           DateTime  @default(now())
}

// A saved, named look ("Dark Gold") the agency can apply to many sub-accounts.
// Holds the visual look only - not client identity (logo/brand name), which
// stays per sub-account.
model ThemePreset {
  id                  String    @id @default(cuid())
  agencyInstallId     String
  agencyInstall       AgencyInstall @relation(fields: [agencyInstallId], references: [id])
  name                String
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  fontFamily          String?
  gradientEnabled     Boolean   @default(false)
  gradientColor       String?
  gradientAngle       Int       @default(135)
  topBarColor         String?
  buttonColor         String?
  cornerRadius        Int?
  scrollbarColor      String?
  darkMode            Boolean   @default(false)
  createdAt           DateTime  @default(now())

  @@index([agencyInstallId])
}

model CustomMenuLinkRegistration {
  id                  String    @id @default(cuid())
  agencyInstallId     String    @unique
  agencyInstall       AgencyInstall @relation(fields: [agencyInstallId], references: [id])
  ghlMenuLinkId       String
  slug                String    @unique
  url                 String
  targetLocationIds   Json
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model WebhookEvent {
  id            String    @id @default(cuid())
  ghlEventId    String    @unique
  eventType     String
  payload       Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  status        WebhookStatus @default(received)
  errorMessage  String?

  @@index([eventType])
}
